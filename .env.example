# See Server/.env.example for the full list. Meta, M-Pesa, email and security settings
# are configured in Admin → Integrations, not here.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5000
SETTINGS_ENCRYPTION_KEY=

# Cloudinary server-side credentials. Never expose these in Client/ files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
