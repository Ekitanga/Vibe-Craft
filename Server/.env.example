PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API. The first is the public site.
CLIENT_ORIGIN=http://localhost:5000

# Use either DATABASE_URL or the PG* variables below.
# DATABASE_URL=postgres://postgres:password@localhost:5432/VibesCraft
PGHOST=localhost
PGPORT=5432
PGDATABASE=VibesCraft
PGUSER=postgres
PGPASSWORD=
PGSSL=false
# Set to true (optionally with PGSSL_CA) to verify the database TLS certificate.
PGSSL_REJECT_UNAUTHORIZED=false
# PGSSL_CA=

# Encrypts integration secrets saved from Admin → Integrations.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Only used to create the FIRST owner on an empty database (never overwrites anyone).
# Prefer: npm run admin:create -- --email you@example.com --password "a-long-unique-password"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Vibecraft Admin
CUSTOMER_SESSION_DAYS=30

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application).
# This is the same value used client-side in Client/google-config.js.
GOOGLE_CLIENT_ID=

# From https://aistudio.google.com/apikey - powers the "Find your setup" AI assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary credentials for product and profile image uploads.
# Keep the API secret on the server; never put it in Client/ files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to false to disable background jobs (stale order expiry, log pruning).
BACKGROUND_JOBS=true

# Tests only: a DISPOSABLE database that `npm test` wipes.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/vibecraft_test

# Meta, M-Pesa, email (SMTP), security limits, consent and policies are configured in
# Admin → Integrations — no environment variables needed.
