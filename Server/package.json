{
  "name": "vibecraft-server",
  "version": "1.0.0",
  "description": "Express API for the Vibecraft projector shop.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check-syntax.js",
    "db:init": "node --no-warnings src/db/init.js",
    "db:reset": "node --no-warnings src/db/init.js --reset",
    "db:pg:init": "node src/db/init-postgres.js",
    "db:pg:reset": "node src/db/init-postgres.js --reset",
    "db:pg:import-live": "node src/db/import-live-products.js",
    "db:pg:migrate-testimonials": "node src/db/migrate.js",
    "db:pg:migrate-admin-controls": "node src/db/migrate.js",
    "admin:create": "node src/db/create-admin.js",
    "test": "node --test --test-concurrency=1 test/",
    "db:migrate": "node src/db/migrate.js"
  },
  "keywords": [
    "express",
    "ecommerce",
    "projectors"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "google-auth-library": "^10.9.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
