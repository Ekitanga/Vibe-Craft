# Vibecraft production settings. Lives at /etc/vibecraft/vibecraft.env (readable by root
# and the vibecraft user only). Restart after editing: sudo systemctl restart vibecraft
#
# Meta, M-Pesa, email, security limits and policies are NOT set here — they are
# configured in Admin → Integrations.

NODE_ENV=production
# Chosen automatically by setup.sh (first free port from 5000).
PORT=__APP_PORT__
# Only nginx is reachable from the internet; the app listens on localhost.
HOST=127.0.0.1
# nginx is one proxy in front of the app.
TRUST_PROXY=1
CLIENT_ORIGIN=https://__DOMAIN__,https://www.__DOMAIN__

# Local PostgreSQL (created by setup.sh). No SSL needed for a local connection.
DATABASE_URL=postgres://vibecraft:__DB_PASSWORD__@127.0.0.1:__DB_PORT__/vibecraft
PGSSL=false

# Encrypts integration secrets saved from the admin. Generated by setup.sh.
# KEEP A COPY somewhere safe (password manager). If you migrate from Render and
# already set a key there, use THAT key instead so saved secrets stay readable.
SETTINGS_ENCRYPTION_KEY=__ENCRYPTION_KEY__

# Copy these from Render → your service → Environment.
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CUSTOMER_SESSION_DAYS=30
BACKGROUND_JOBS=true
