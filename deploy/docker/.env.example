# Copy to .env (chmod 600). Never commit .env.
# Meta, M-Pesa, email and security settings are configured in Admin → Integrations.

# Database password for this project only. Generate: openssl rand -hex 24
DB_PASSWORD=

# Encrypts integration secrets. Generate: openssl rand -base64 32
# Keep a copy in a password manager. If Render already has one, reuse Render's value.
SETTINGS_ENCRYPTION_KEY=

CLIENT_ORIGIN=https://vibecraft254.com,https://www.vibecraft254.com

# Copy from Render → vibecraft service → Environment
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CUSTOMER_SESSION_DAYS=30
BACKGROUND_JOBS=true

# Port on 127.0.0.1 for checks from the server itself (must be unused; 4100 is taken).
APP_HOST_PORT=4200
# Docker network shared with the Caddy proxy.
PROXY_NETWORK=contabo_default
